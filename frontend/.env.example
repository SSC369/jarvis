# Every variable the frontend reads. Names only, never values.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# The GraphQL HTTP endpoint.
VITE_GRAPHQL_HTTP_URL=http://localhost:8000/graphql

# The GraphQL WebSocket endpoint, for subscriptions.
VITE_GRAPHQL_WS_URL=ws://localhost:8000/graphql

# Supabase project, for auth only. The browser never talks to a Supabase data
# API directly (tech stack rule T1): only auth.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
